{
  "project": "Mess Billing MVP Flask -> Laravel Parity",
  "phase": "Phase 2 Mapping",
  "launch_critical_definition": "Minimum production-safe scope for billing operations, month governance, accounting integrity, and access control.",
  "must_have_modules": [
    "authentication_and_session_control",
    "user_role_permission_management",
    "member_lifecycle_management",
    "daily_and_monthly_attendance",
    "extras_and_rate_policy_control",
    "billing_generation_and_correction",
    "payment_entry_and_approval",
    "member_ledger_and_recompute_tools",
    "month_close_reopen_hard_reset_controls",
    "core_reports_statement_summary",
    "audit_log_and_traceability",
    "app_settings_runtime_controls"
  ],
  "must_have_routes": [
    "/login",
    "/logout",
    "/change-password",
    "/password-reset/request",
    "/password-reset",
    "/admin/dashboard",
    "/admin/users",
    "/admin/members",
    "/admin/attendance",
    "/admin/attendance-monthly",
    "/admin/extras",
    "/admin/rates",
    "/admin/billing",
    "/admin/billing/generate",
    "/admin/billing/{bill}/correct",
    "/admin/payments",
    "/admin/payments/{payment}/approve",
    "/admin/payments/{payment}/edit",
    "/admin/ledger",
    "/admin/ledger/adjustments",
    "/admin/import-ledger",
    "/admin/import-opening-balances",
    "/admin/recompute-ledger",
    "/admin/month-close",
    "/admin/month-reopen",
    "/admin/month-reset-hard",
    "/admin/summary",
    "/admin/reports",
    "/admin/statement",
    "/admin/reports/bills-download",
    "/admin/audit-log",
    "/admin/settings"
  ],
  "must_have_workflows": [
    "auth_login_logout_password_rotation",
    "member_create_update_deactivate_reactivate",
    "attendance_capture_and_monthly_lock",
    "rate_approval_then_billing_run",
    "billing_correction_with_audit_trail",
    "payment_post_then_approve_then_ledger_reflect",
    "ledger_opening_import_and_recompute",
    "month_close_reopen_with_guardrails",
    "statement_summary_reports_generation"
  ],
  "must_have_permissions": [
    "auth.login",
    "user.manage",
    "member.manage",
    "attendance.manage",
    "rate.manage",
    "billing.generate",
    "billing.correct",
    "payment.create",
    "payment.approve",
    "ledger.adjust",
    "ledger.recompute",
    "month.close",
    "month.reopen",
    "month.reset_hard",
    "report.view",
    "report.export",
    "settings.manage",
    "audit.view"
  ],
  "must_have_reports": [
    "member_statement",
    "billing_summary_monthly",
    "payment_recovery_view",
    "attendance_summary",
    "ledger_extract"
  ],
  "explicitly_out_of_launch_scope": [
    "inventory_management",
    "procurement_po_grn",
    "meal_planning_recipe_kitchen_issue",
    "guest_management_and_guest_meals",
    "department_and_mess_cost_accounting",
    "ops_hub_reports_hub_inventory_hub_meals_hub",
    "non_critical_debug_endpoints"
  ]
}